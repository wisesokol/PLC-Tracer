<Programs>
<Program Name="Diagnostics" TestEdits="false" MainRoutineName="DiagMain" Disabled="false">
<Description>
<![CDATA[Chains 14-15: JSR/SBR/RET flow control, GSV/SSV/TND/AFI/NOP system]]>
</Description>
<Tags>
<Tag Name="Diag_Local" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data>00 00 00 00</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Diag_Skip" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data>00</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="CalcRoutine" Type="RLL">
<Description>
<![CDATA[Chain 14: Subroutine - SBR receive, MUL, JMP/LBL, RET]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[SBR: receive two input parameters]]>
</Comment>
<Text>
<![CDATA[SBR(Diag_Local,Diag_Tmp)NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[JMP: skip multiply if inputs equal]]>
</Comment>
<Text>
<![CDATA[EQU(Diag_Local,Diag_Tmp)JMP(SkipCalc);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[MUL: multiply inputs -> Diag_Tmp]]>
</Comment>
<Text>
<![CDATA[MUL(Diag_Local,Diag_Tmp,Diag_Tmp);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[LBL: jump target + NOP]]>
</Comment>
<Text>
<![CDATA[LBL(SkipCalc)NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[RET: return computed result]]>
</Comment>
<Text>
<![CDATA[RET(Diag_Tmp);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DiagMain" Type="RLL">
<Description>
<![CDATA[Chains 14-15: JSR call, GSV/SSV system, TND/AFI/NOP]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Chain 14: Cross-program ref - JSR to CalcRoutine when System_Running AND DI.14]]>
</Comment>
<Text>
<![CDATA[XIC(System_Running)XIC(Local:1:I.Data.14)JSR(CalcRoutine,2,Sub_InA,Sub_InB,Sub_RetVal);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Chain 14: Subroutine result check -> DO.14]]>
</Comment>
<Text>
<![CDATA[GRT(Sub_RetVal,0)OTE(Local:2:O.Data.14);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Chain 15: GSV read main task scan time]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.15)GSV(Task,MainTask,LastScanTime,ScanTime);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Chain 15: SSV write task watchdog value]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.15)SSV(Task,MainTask,Watchdog,TaskStatus);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Chain 15: TND stops scan when DI.15 OFF (remaining rungs only execute when DI.15 ON)]]>
</Comment>
<Text>
<![CDATA[XIO(Local:1:I.Data.15)TND();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Chain 15: CLR temp and drive output -> DO.15]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.15)[CLR(Diag_Tmp) ,OTE(Local:2:O.Data.15) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Chain 15: AFI always-false disabled rung (visualizer test)]]>
</Comment>
<Text>
<![CDATA[AFI()OTE(Diag_Skip);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Chain 15: NOP end-of-chain marker]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false">
<Description>
<![CDATA[Chains 0-10: Start/Stop, Timers, Counters, Comparisons, Math, Bitwise, Arrays]]>
</Description>
<Tags>
<Tag Name="Init_Done" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Program-scope init flag (cross-program ref target)]]>
</Description>
<Data>01</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
<Tag Name="Status" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Scope test: same name as ProcessControl.Status]]>
</Description>
<Data>00 00 00 00</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<Description>
<![CDATA[Chains 0-10: 34 rungs, 16 DI to DO logic chains]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Chain 0: Start button (DI.0) one-shot latches System_Running]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.0)ONS(ONS_Start)OTL(System_Running);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Chain 0: System active indicator -> DO.0]]>
</Comment>
<Text>
<![CDATA[XIC(System_Running)[OTE(Local:2:O.Data.0) ,OTL(Chain_Active.0) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Chain 1: Stop button (DI.1) unlatches System_Running]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.1)OTU(System_Running);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Chain 1: TOF off-delay 3s after System_Running drops]]>
</Comment>
<Text>
<![CDATA[XIC(System_Running)TOF(TOF_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Chain 1: Delayed stop output -> DO.1]]>
</Comment>
<Text>
<![CDATA[XIO(Local:1:I.Data.1)XIC(TOF_Timer.DN)OTE(Local:2:O.Data.1);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Chain 2: E-Stop (DI.2) latches alarm, kills system]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.2)[OTL(EStop_Alarm) ,OTL(Alarm_Word.0) ,OTU(System_Running) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Chain 2: Reset clears E-Stop alarm when DI.2 released]]>
</Comment>
<Text>
<![CDATA[XIC(EStop_Reset)XIO(Local:1:I.Data.2)[OTU(EStop_Alarm) ,OTU(Alarm_Word.0) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Chain 2: Beacon output -> DO.2]]>
</Comment>
<Text>
<![CDATA[XIC(EStop_Alarm)OTE(Local:2:O.Data.2);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Chain 3: First TON delay 2s from DI.3]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.3)XIO(TON_Chain_1.DN)TON(TON_Chain_1,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Chain 3: Second TON delay 1.5s after first completes]]>
</Comment>
<Text>
<![CDATA[XIC(TON_Chain_1.DN)XIO(TON_Chain_2.DN)TON(TON_Chain_2,?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Chain 3: Timer chain complete -> DO.3]]>
</Comment>
<Text>
<![CDATA[XIC(TON_Chain_2.DN)OTE(Local:2:O.Data.3);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Chain 4: DI.4 pulse counted by CTU (preset=10)]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.4)ONS(ONS_Batch)CTU(Batch_CTU,?,?);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Chain 4: Batch complete - latch done, reset counter]]>
</Comment>
<Text>
<![CDATA[XIC(Batch_CTU.DN)[OTL(Batch_Done) ,RES(Batch_CTU) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Chain 4: Batch done -> DO.4]]>
</Comment>
<Text>
<![CDATA[XIC(Batch_Done)OTE(Local:2:O.Data.4);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Chain 5: DI.5 counts down (CTD, preset=5, ACC starts at 5)]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.5)CTD(Down_CTD,?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Chain 5: Countdown reached zero -> DO.5]]>
</Comment>
<Text>
<![CDATA[LEQ(Down_CTD.ACC,0)OTE(Local:2:O.Data.5);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Chain 6: RTO retentive timer accumulates while DI.6 on (5s)]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.6)RTO(RTO_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Chain 6: RTO done -> DO.6]]>
</Comment>
<Text>
<![CDATA[XIC(RTO_Timer.DN)OTE(Local:2:O.Data.6);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Chain 6: RTO reset]]>
</Comment>
<Text>
<![CDATA[XIC(RTO_Reset)RES(RTO_Timer);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Chain 7: Load comparison value when DI.7 active]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.7)MOV(50,Cmp_Val);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Chain 7: Six comparisons EQU NEQ GRT GEQ LES LEQ -> flag bits]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.7)[EQU(Cmp_Val,50) OTL(Cmp_Flags.0) ,NEQ(Cmp_Val,99) OTL(Cmp_Flags.1) ,GRT(Cmp_Val,10) OTL(Cmp_Flags.2) ,GEQ(Cmp_Val,50) OTL(Cmp_Flags.3) ,LES(Cmp_Val,100) OTL(Cmp_Flags.4) ,LEQ(Cmp_Val,50) OTL(Cmp_Flags.5) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Chain 7: LIM and MEQ checks]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.7)[LIM(10,Cmp_Val,100) OTL(Cmp_Flags.6) ,MEQ(Cmp_Val,16#0000_00FF,16#0000_0032) OTL(Cmp_Flags.7) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Chain 7: All 8 flags set -> DO.7]]>
</Comment>
<Text>
<![CDATA[XIC(Cmp_Flags.0)XIC(Cmp_Flags.1)XIC(Cmp_Flags.2)XIC(Cmp_Flags.3)XIC(Cmp_Flags.4)XIC(Cmp_Flags.5)XIC(Cmp_Flags.6)XIC(Cmp_Flags.7)OTE(Local:2:O.Data.7);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Chain 8: Init math chain - MOV operands, CLR result]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.8)[MOV(100,Math_A) ,MOV(7,Math_B) ,CLR(Math_Result) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Chain 8: ADD SUB MUL DIV MOD in parallel branches]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.8)[ADD(Math_A,Math_B,Math_Tmp) ,SUB(Math_A,Math_B,Math_Tmp2) ,MUL(Math_A,Math_B,Math_Tmp3) ,DIV(Math_A,Math_B,Math_Tmp4) ,MOD(Math_A,Math_B,Cmp_Val) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Chain 8: NEG ABS SQR CPT in parallel branches]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.8)[NEG(Math_Tmp2,Math_Tmp) ,ABS(Math_Tmp,Math_Tmp2) ,SQR(Math_Tmp3,Math_RealTmp) ,CPT(Math_RealTmp2,Math_RealTmp+Math_Tmp2*1.0) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Chain 8: Math result check -> DO.8]]>
</Comment>
<Text>
<![CDATA[GRT(Math_RealTmp2,0.0)OTE(Local:2:O.Data.8);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Chain 9: AND OR XOR bitwise operations]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.9)[AND(Bit_Src,Bit_Mask,Bit_Tmp1) ,OR(Bit_Src,16#0000_FF00,Bit_Tmp2) ,XOR(Bit_Src,16#0000_FFFF,Bit_Tmp3) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Chain 9: NOT BTD MVM bitwise operations]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.9)[NOT(Bit_Src,Bit_Tmp4) ,BTD(Bit_Src,0,Bit_Tmp5,8,4) ,MVM(Bit_Src,16#0000_00FF,Bit_Tmp6) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Chain 9: Bitwise results non-zero -> DO.9]]>
</Comment>
<Text>
<![CDATA[NEQ(Bit_Tmp1,0)NEQ(Bit_Tmp4,0)NEQ(Bit_Tmp6,0)OTE(Local:2:O.Data.9);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Chain 10: COP array copy, FLL fill source with zeros]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.10)[COP(Arr_Src[0],Arr_Dst[0],10) ,FLL(0,Arr_Src[0],10) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Chain 10: SIZE get array length, SRT sort destination]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.10)[SIZE(Arr_Dst,0,Arr_Size) ,SRT(Arr_Dst[0],0,Sort_CTL,?,?) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Chain 10: SWPB byte swap, DTOS integer to string]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.10)[SWPB(Arr_Dst[0],REVERSE,Swap_Tmp) ,DTOS(Arr_Dst[0],Str_Buf) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Chain 10: Array size check -> DO.10]]>
</Comment>
<Text>
<![CDATA[EQU(Arr_Size,10)OTE(Local:2:O.Data.10);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="ProcessControl" TestEdits="false" MainRoutineName="ProcMain" Disabled="false">
<Description>
<![CDATA[Chains 11-13: AOI Scale, OSR/OSF edge detection, Recipe/Motor UDT]]>
</Description>
<Tags>
<Tag Name="Proc_Tmp" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>00 00 00 00</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</Data>
</Tag>
<Tag Name="Status" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Scope test: same name as MainProgram.Status]]>
</Description>
<Data>00 00 00 00</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="ProcMain" Type="RLL">
<Description>
<![CDATA[Chains 11-13: AOI, OSR/OSF, Recipe+Motor]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Chain 11: Load raw value when DI.11 active]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.11)MOV(16384,Scale_RawVal);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Chain 11: AOI_Scale call - linear scaling 0-32767 -> 0-100]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.11)AOI_Scale(Scale_T,Scale_RawVal,0,32767,0.0,100.0,Scale_Result);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Chain 11: Scaled value in range -> DO.11]]>
</Comment>
<Text>
<![CDATA[GRT(Scale_Result,10.0)LES(Scale_Result,90.0)OTE(Local:2:O.Data.11);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Chain 12: OSR rising edge detection on DI.12]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.12)OSR(OSR_Store,OSR_Out);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Chain 12: OSR pulse latches DO.12 on]]>
</Comment>
<Text>
<![CDATA[XIC(OSR_Out)OTL(Local:2:O.Data.12);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Chain 12: OSF falling edge detection on DI.12]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.12)OSF(OSF_Store,OSF_Out);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Chain 12: OSF pulse unlatches DO.12]]>
</Comment>
<Text>
<![CDATA[XIC(OSF_Out)OTU(Local:2:O.Data.12);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Chain 13: Cross-program ref - load motor speed from recipe if init done]]>
</Comment>
<Text>
<![CDATA[XIC(Init_Done)XIC(Local:1:I.Data.13)MOV(Recipe_1.Speed,Motor_1.Speed);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Chain 13: Load recipe temperature, set motor running/enabled]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.13)[MOV(Recipe_1.Temperature,Proc_Tmp) ,OTL(Motor_1.Running) ,OTL(Motor_1.Enabled) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Chain 13: Temperature within limits AND motor speed valid -> DO.13]]>
</Comment>
<Text>
<![CDATA[LIM(Alm_Temp.LowLimit,Proc_Tmp,Alm_Temp.HighLimit)GRT(Motor_1.Speed,0.0)LES(Motor_1.Speed,2000.0)OTE(Local:2:O.Data.13);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Chain 13: Update program-scope Status (scope clash test)]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.13)MOV(1,Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
